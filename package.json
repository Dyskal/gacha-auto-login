{
  "name": "gacha-auto",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun index.ts",
    "cron": "bun index.ts --cron",
    "typecheck": "bun check",
    "build:linux-x64": "bun build index.ts --compile --minify --sourcemap --bytecode --target=bun-linux-x64 --outfile dist/gacha-auto-linux-x64",
    "build:linux-arm64": "bun build index.ts --compile --minify --sourcemap --bytecode --target=bun-linux-arm64 --outfile dist/gacha-auto-linux-arm64",
    "build:windows-x64": "bun build index.ts --compile --minify --sourcemap --bytecode --target=bun-windows-x64 --outfile dist/gacha-auto-windows-x64.exe",
    "build:darwin-x64": "bun build index.ts --compile --minify --sourcemap --bytecode --target=bun-darwin-x64 --outfile dist/gacha-auto-darwin-x64",
    "build:darwin-arm64": "bun build index.ts --compile --minify --sourcemap --bytecode --target=bun-darwin-arm64 --outfile dist/gacha-auto-darwin-arm64"
  },
  "devDependencies": {
    "bun-types": "^1.4.4"
  }
}
